{% include 'includes/header.html.twig' with {
	'title': vendor ~ ' – ' ~ product,
	'description': 'Having problems with notifications, background tasks, automatic synchronization or alarms for “' ~ product ~ '” on your ' ~ vendor ~ ' device?'
} only %}
<h1>{{ vendor }}</h1>
{% if devices %}
	<hr>
	<p class="lead text-center">
		Having problems with notifications, background tasks, automatic synchronization or alarms on your {{ vendor }} device?
	</p>
	<hr>
	<h2>Choose your device</h2>
	<ul>
		{% for device in devices %}
			<li>
				<a href="{{ app.url(app.currentRoute() ~ '/' ~ (device | url_encode)) }}">
					{{ device }}
				</a>
			</li>
		{% endfor %}
	</ul>
{% endif %}
{% include 'includes/footer.html.twig' only %}
