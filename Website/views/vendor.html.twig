{% include 'includes/header.html.twig' with {
	'title': vendor ~ ' – ' ~ product,
	'description': _f('Having problems with notifications, background tasks, automatic synchronization or alarms for “%1$s” on your %2$s device?', product, vendor)
} only %}
<h1>{{ vendor }}</h1>
{% if devices %}
	<hr>
	<p class="lead text-center">
		{{ _f('Having problems with notifications, background tasks, automatic synchronization or alarms on your %s device?', vendor) }}
	</p>
	<hr>
	<h2>{{ _('Choose your device') }}</h2>
	{% if suggestedDevice %}
		<ul>
			<li>
				<a href="{{ app.urlWithLang(app.currentRoute() ~ '/' ~ (suggestedDevice | url_encode)) }}">
					<mark>{{ suggestedDevice }}</mark>
				</a>
			</li>
		</ul>
		<hr>
	{% endif %}
	<ul>
		{% for device in devices %}
			<li>
				<a href="{{ app.urlWithLang(app.currentRoute() ~ '/' ~ (device | url_encode)) }}">
					{{ device }}
				</a>
			</li>
		{% endfor %}
	</ul>
{% endif %}
{% include 'includes/footer.html.twig' only %}
