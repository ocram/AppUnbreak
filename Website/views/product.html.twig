{% include 'includes/header.html.twig' with {
	'title': product,
	'description': _f('Having problems with notifications, background tasks, automatic synchronization or alarms for “%s”?', product)
} only %}
<h1>{{ product }}</h1>
<small class="d-block text-center">{{ company }}</small>
{% if vendors and vendors.primary and vendors.secondary %}
	<hr>
	<p class="lead text-center">
		{{ _('Are you having problems with notifications, background tasks, automatic synchronization or alarms on your device?') }}
	</p>
	<p>
		{{ _('Some manufacturers are forcing excessive restrictions upon their devices in faulty attempts at battery optimization.') }}
	</p>
	<p>
		{{ _('While these limitations extend battery life on paper, they do so at the expense of your device’s functionality and of your own convenience.') }}
	</p>
	<hr>
	<h2>{{ _('Choose your vendor') }}</h2>
	<p class="lead text-center">
		{{ _('Learn what you can do to prevent flawed power-saving features from breaking your device’s features.') }}
	</p>
	<ul>
		{% for vendor in vendors.primary %}
			<li>
				<a href="{{ app.url(app.currentRoute() ~ '/' ~ (vendor.0 | url_encode)) }}">
					{{ vendor.0 }}
				</a>
			</li>
		{% endfor %}
	</ul>
	<hr>
	<ul>
		{% for vendor in vendors.secondary %}
			<li>
				<a href="{{ app.url(app.currentRoute() ~ '/' ~ (vendor.0 | url_encode)) }}">
					{{ vendor.0 }}
				</a>
			</li>
		{% endfor %}
	</ul>
{% endif %}
{% include 'includes/footer.html.twig' only %}
