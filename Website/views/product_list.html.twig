{% include 'includes/header.html.twig' with {
	'title': _('Apps')
} only %}
<h1>{{ _('Apps') }}</h1>
<hr>
<p class="lead text-center">
	{{ _('Are you having problems with notifications, background tasks, automatic synchronization or alarms on your device?') }}
</p>
{% if products %}
	<hr>
	<h2>{{ _('Choose your app') }}</h2>
	<ul>
		{% for appNameSlug, productDefinition in products %}
			<li>
				<a href="{{ app.urlWithLang('/a/' ~ (appNameSlug | url_encode)) }}">
					{{ productDefinition.title }}
				</a>
			</li>
		{% endfor %}
	</ul>
{% endif %}
{% include 'includes/footer.html.twig' only %}
