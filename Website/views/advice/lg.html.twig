{% if androidMax >= '00.00.00' and androidMin <= '99.99.99' %}
	{% include 'advice/includes/header.html.twig' with { 'uuid': '7cacad2d-f579-4282-accc-8ecca42a13d1' } only %}
		<li>{{ _('Open the “Settings” of your device.') }}</li>
		<li>{{ _('Choose “Battery & power saving”.') }}</li>
