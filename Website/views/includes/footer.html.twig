			</div>
		</main>
		<footer class="footer mt-auto">
			<div class="im-delight-appunbreak-footer-inner">
				<div class="container text-center text-muted small">
					<ul class="list-inline">
						{% for localeCode in app.i18n().getSupportedLocales() %}
							<li class="list-inline-item">
								<a href="{{ app.currentUrlWithQueryAndParams({ 'lang': localeCode }) }}">
									{{ app.i18n().getNativeLanguageName(localeCode) }}
								</a>
							</li>
						{% endfor %}
					</ul>
				</div>
				<div class="container text-center text-muted small d-none d-lg-block">
					<strong>{{ _('Developers:') }}</strong>
					<a href="{{ app.urlWithLang('/contact') }}" rel="nofollow">{{ _('Get a site like this for your own app!') }}</a>
				</div>
				<div class="container text-center text-muted small clearfix">
					<span class="float-left">
						&copy; <a href="{{ COMPANY_URL }}" rel="noopener noreferrer" class="text-reset">{{ COMPANY_NAME }}</a>
					</span>
					<ul class="list-inline float-right mb-0">
						{% if (not (app.currentRoute() starts with '/a/')) or (app.currentRoute() == '/a/example') or (app.currentRoute() starts with '/a/example/') %}
							<li class="list-inline-item">
								<a href="{{ app.urlWithLang('/apps') }}">{{ _('Apps') }}</a>
							</li>
						{% endif %}
						<li class="list-inline-item">
							<a href="{{ app.urlWithLang('/privacy') }}" rel="nofollow">{{ _('Privacy') }}</a>
						</li>
						<li class="list-inline-item">
							<a href="{{ app.urlWithLang('/contact') }}" rel="nofollow">{{ _('Contact') }}</a>
						</li>
					</ul>
				</div>
			</div>
		</footer>
		<script src="{{ app.url('/js/custom.min.js?v=1') }}"></script>
		{% include 'includes/analytics.html.twig' only %}
	</body>
</html>
