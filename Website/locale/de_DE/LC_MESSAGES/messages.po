msgstr "Tippe auf „Anwendungen hinzufügen“."

msgid "Tap on “Advanced optimization”."
msgstr "Tippe auf „Erweiterte Optimierung“."

msgid "Tap on “Advanced”."
msgstr "Tippe auf „Erweitert“."

msgid "Tap on “Apps active in standby”."
msgstr "Tippe auf „Apps aktiv im Ruhezustand“."

msgid "Tap on “Background activity manager”."
msgstr "Tippe auf „Hintergrund-Aktivitäts-Verwalter“."

msgid "Tap on “Battery saver”."
msgstr "Tippe auf „Akkusparer“."

