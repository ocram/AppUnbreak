msgstr "Datenschutz"

#, php-format
msgid "Put a checkmark into the checkbox next to “%s”."
msgstr "Setze einen Haken ins Kontrollkästchen neben „%s“."

msgid "Restart your device."
msgstr "Starte dein Gerät neu."

msgid "Select “Never”."
msgstr "Wähle „Niemals“ aus."

msgid "Select “No restrictions”."
msgstr "Wähle „Keine Einschränkungen“ aus."

msgid "Select “Normal mode”."
msgstr "Wähle „Normaler Modus“ aus."

msgid "Select “Smart Manager”."
msgstr "Wähle „Smart Manager“."

msgid "Select “Turned off”."
msgstr "Wähle „Deaktiviert“ aus."

msgid "Set it to “Off”."
msgstr "Setze es auf „Aus“."

msgid "Set the threshold to a low battery level so that power saving is not enabled too often or too early."
msgstr "Setze die Schwelle oder den Grenzwert auf einen niedrigen Akkustand, sodass das Energiesparen nicht zu oft oder zu früh aktiviert wird."

msgid "Set the threshold to a low percent value, e.g. “At 15%”."
msgstr "Setze die Schwelle oder den Grenzwert auf einen niedrigen Prozentwert, z.B. „Bei 15%“."

msgid "Some manufacturers are forcing excessive restrictions upon their devices in faulty attempts at battery optimization."
msgstr "In mangelhaften Versuchen, die Akkulaufzeiten zu optimieren, zwingen einige Hersteller ihren Geräten übermäßige Beschränkungen auf."

msgid "Swipe from the right to the left."
msgstr "Wische von rechts nach links."

msgid "Switch from “Not allowed” to “Allow”."
msgstr "Wechsle von „Nicht erlaubt“ zu „Erlauben“."

msgid "Switch from “Optimization” to “Do not optimize”."
msgstr "Wechsle von „Optimierung“ zu „Nicht optimieren“."

msgid "Switch from “Optimize” to “Don’t optimize”."
msgstr "Wechsle von „Optimieren“ zu „Nicht optimieren“."

msgid "Switch to the “All others” section."
msgstr "Wechsle zum Bereich „Alle anderen“."

msgid "Switch to “Don’t optimize”."
msgstr "Wechsle auf „Nicht optimieren“."

msgid "Switch to “Normal clear”."
msgstr "Wechsle auf „Normal aufräumen“."

#, php-format
